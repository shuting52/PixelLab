        <item name="colorPrimary">@color/pixel_blue</item>
        <item name="colorPrimaryVariant">@color/pixel_purple</item>
        <item name="colorSecondary">@color/pixel_cyan</item>
        <item name="android:statusBarColor">@color/pixel_bg_deep</item>
        <item name="android:navigationBarColor">@color/pixel_bg_deep</item>
